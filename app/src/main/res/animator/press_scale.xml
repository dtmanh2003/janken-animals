<?xml version="1.0" encoding="utf-8"?>
<!-- 手のボタンを押している間だけ少し沈む（タッチ処理を自前で書かずに済むので、TalkBackでも普通に押せる） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:duration="80" android:propertyName="scaleX" android:valueTo="0.94" android:valueType="floatType" />
            <objectAnimator android:duration="80" android:propertyName="scaleY" android:valueTo="0.94" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="120" android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" />
            <objectAnimator android:duration="120" android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" />
        </set>
    </item>
</selector>
