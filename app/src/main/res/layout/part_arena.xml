<?xml version="1.0" encoding="utf-8"?>
<!-- 対戦エリア（動物は「ふだんの姿」と「変身後」の2枚を重ねて、HTML版と同じように入れ替える） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/arena"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="14dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- あなた -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/label_you" />

            <FrameLayout
                android:id="@+id/boxPlayer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/animal_box_height"
                android:clipChildren="false"
                android:contentDescription="@string/cd_player_hand">

                <View
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_hand_circle" />

                <ImageView
                    android:id="@+id/imgPlayerIdle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/animal_fox_idle" />

                <ImageView
                    android:id="@+id/imgPlayerPose"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtPlayerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_main"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_vs"
            android:textColor="@color/accent_light"
            android:textSize="22sp"
            android:textStyle="bold|italic" />

        <!-- コンピュータ（箱ごと左右反転して向かい合わせにする） -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/label_cpu" />

            <FrameLayout
                android:id="@+id/boxCpu"
                android:layout_width="match_parent"
                android:layout_height="@dimen/animal_box_height"
                android:clipChildren="false"
                android:contentDescription="@string/cd_cpu_hand"
                android:scaleX="-1">

                <View
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_hand_circle" />

                <ImageView
                    android:id="@+id/imgCpuIdle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/animal_eagle_idle" />

                <ImageView
                    android:id="@+id/imgCpuPose"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtCpuName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_main"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 結果メッセージ -->
    <TextView
        android:id="@+id/txtResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/msg_start"
        android:textColor="@color/text_main"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtStreak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/draw"
        android:textSize="14sp" />
</LinearLayout>
